# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Supabase / PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Example for Supabase: postgresql://postgres.xxxx:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/omkar_nagu_db?schema=public"

# Supabase Client Credentials (Optional if connecting via Prisma / direct PostgreSQL)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT Authentication Secret
JWT_SECRET="omkar_nagu_electrical_works_secret_key_2026_super_secure"

# Frontend Configuration (in frontend/.env)
VITE_API_URL="http://localhost:5000"
VITE_WHATSAPP_NUMBER="919494666420"
